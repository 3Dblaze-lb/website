{
  "rules": {
    "admins": {
      ".read": false,
      ".write": false
    },
    "products": {
      ".read": true,
      ".write": "auth != null && auth.token.email === '3dbllaze@gmail.com' && auth.token.email_verified === true"
    },
    "extraProducts": {
      ".read": true,
      ".write": "auth != null && auth.token.email === '3dbllaze@gmail.com' && auth.token.email_verified === true"
    },
    "settings": {
      ".read": true,
      ".write": "auth != null && auth.token.email === '3dbllaze@gmail.com' && auth.token.email_verified === true"
    },
    "orders": {
      ".read": "auth != null && auth.token.email === '3dbllaze@gmail.com' && auth.token.email_verified === true",
      "$code": {
        ".write": "(!data.exists() && newData.child('code').val() === $code) || (auth != null && auth.token.email === '3dbllaze@gmail.com' && auth.token.email_verified === true)",
        ".validate": "newData.hasChildren(['code', 'items', 'total', 'customer', 'createdAt'])"
      }
    },
    "tracking": {
      "$code": {
        ".read": true,
        ".write": "!data.exists() || (auth != null && auth.token.email === '3dbllaze@gmail.com' && auth.token.email_verified === true)"
      }
    },
    "requests": {
      ".read": "auth != null && auth.token.email === '3dbllaze@gmail.com' && auth.token.email_verified === true",
      ".write": "auth != null && auth.token.email === '3dbllaze@gmail.com' && auth.token.email_verified === true"
    },
    "presence": {
      ".read": "auth != null && auth.token.email === '3dbllaze@gmail.com' && auth.token.email_verified === true",
      "$id": {
        ".write": true,
        ".validate": "!newData.exists() || (newData.hasChildren(['t']) && (!newData.child('page').exists() || (newData.child('page').isString() && newData.child('page').val().length <= 40)))"
      }
    }
  }
}
